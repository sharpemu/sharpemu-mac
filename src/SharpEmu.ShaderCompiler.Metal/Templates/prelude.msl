// A raw dword load: the address truncates to the dword it lands in, which is what the
// hardware does for S_BUFFER_LOAD_DWORD and BUFFER_LOAD_DWORD and what the SPIR-V
// backend emits. Out of range reads zero.
static inline uint sharpemu_load_dword(device uint* b, uint bytes, uint addr)
{
    uint index = addr >> 2;
    return index < (bytes >> 2) ? b[index] : 0u;
}

// Up to four consecutive raw dwords of an S_BUFFER_LOAD/BUFFER_LOAD_DWORDXn, each what
// sharpemu_load_dword reads at addr + 4 * i. A run that lies inside the binding is one
// bounds check and adjacent loads; one that crosses the end reads dword by dword.
template <int N>
static inline uint4 sharpemu_load_dwords(device uint* b, uint bytes, uint addr)
{
    uint4 result = uint4(0u);
    uint index = addr >> 2;
    uint words = bytes >> 2;
    if (index < words && (uint)N <= words - index)
    {
        for (int i = 0; i < N; i++)
        {
            result[i] = b[index + (uint)i];
        }
    }
    else
    {
        for (int i = 0; i < N; i++)
        {
            result[i] = sharpemu_load_dword(b, bytes, addr + (uint)(4 * i));
        }
    }
    return result;
}

// A dword a format access may straddle, assembled from the two it spans. Only the
// format path needs this: a descriptor's stride is a byte count, so a component can
// start at any byte.
static inline uint sharpemu_load_word(device uint* b, uint bytes, uint addr)
{
    if ((addr & 3u) == 0u)
    {
        return addr + 4u <= bytes ? b[addr >> 2] : 0u;
    }
    uint shift = (addr & 3u) * 8u;
    uint aligned = addr & ~3u;
    uint low = sharpemu_load_dword(b, bytes, aligned);
    uint high = sharpemu_load_dword(b, bytes, aligned + 4u);
    return (low >> shift) | (high << (32u - shift));
}

// Up to four consecutive dwords starting at a byte address, for a format whose components
// are whole dwords. An aligned run that lies inside the binding is plain dword loads;
// anything else (an odd bias, a run that crosses the end) reads each dword through
// sharpemu_load_word, which assembles a straddled dword and reads zero past the end.
template <int N>
static inline uint4 sharpemu_load_words(device uint* b, uint bytes, uint addr)
{
    uint4 result = uint4(0u);
    if ((addr & 3u) == 0u && addr <= bytes && (uint)(4 * N) <= bytes - addr)
    {
        uint index = addr >> 2;
        for (int i = 0; i < N; i++)
        {
            result[i] = b[index + (uint)i];
        }
    }
    else
    {
        for (int i = 0; i < N; i++)
        {
            result[i] = sharpemu_load_word(b, bytes, addr + (uint)(4 * i));
        }
    }
    return result;
}

static inline uint sharpemu_load_bytes(device uint* b, uint bytes, uint addr, uint count, bool signExtend)
{
    uint value = 0u;
    device const uchar* p = (device const uchar*)b;
    for (uint i = 0u; i < count; i++)
    {
        if (addr + i < bytes)
        {
            value |= (uint)p[addr + i] << (i * 8u);
        }
    }
    if (signExtend && count < 4u)
    {
        uint shift = 32u - (count * 8u);
        value = (uint)(((int)(value << shift)) >> shift);
    }
    return value;
}

// A raw dword store, the counterpart of sharpemu_load_dword: BUFFER_STORE_DWORD and
// GLOBAL_STORE_DWORD are dword-addressed by the GCN ISA, so the address truncates and
// the dword is written. Out of range is dropped. Going through the byte path instead
// turned one dword store into four byte stores, each with its own bounds check, which
// device memory charges for four times over.
static inline void sharpemu_store_dword(device uint* b, uint bytes, uint addr, uint value)
{
    uint index = addr >> 2;
    if (index < (bytes >> 2))
    {
        b[index] = value;
    }
}

// A sub-dword store: the bytes it names, each merged in place.
static inline void sharpemu_store_bytes(device uint* b, uint bytes, uint addr, uint value, uint count)
{
    device uchar* p = (device uchar*)b;
    for (uint i = 0u; i < count; i++)
    {
        if (addr + i < bytes)
        {
            p[addr + i] = (uchar)((value >> (i * 8u)) & 0xFFu);
        }
    }
}

static inline void sharpemu_store_masked_word(device uint* b, uint bytes, uint index, uint value, uint mask)
{
    if (mask == 0u || index >= (bytes >> 2))
    {
        return;
    }
    if (mask == 0xFFFFFFFFu)
    {
        b[index] = value;
        return;
    }
    // The other bits of the word survive stores from neighbouring invocations.
    device atomic_uint* word = (device atomic_uint*)(b + index);
    uint observed = atomic_load_explicit(word, memory_order_relaxed);
    while (!atomic_compare_exchange_weak_explicit(word, &observed, (observed & ~mask) | value, memory_order_relaxed, memory_order_relaxed))
    {
    }
}

static inline void sharpemu_store_element(device uint* b, uint bytes, uint addr, uint count, uint4 values, uint4 masks)
{
    uint shift = (addr & 3u) * 8u;
    uint index = addr >> 2;
    uint carryValue = 0u;
    uint carryMask = 0u;
    for (uint k = 0u; k <= count; k++)
    {
        uint value = carryValue;
        uint mask = carryMask;
        if (k < count)
        {
            uint element = values[k] & masks[k];
            value |= element << shift;
            mask |= masks[k] << shift;
            carryValue = shift == 0u ? 0u : element >> (32u - shift);
            carryMask = shift == 0u ? 0u : masks[k] >> (32u - shift);
        }
        sharpemu_store_masked_word(b, bytes, index + k, value, mask);
    }
}

static inline uint sharpemu_ballot(bool value)
{
    return {{ballot_return}};
}

// The nearest launched lane at or below lane, else the lowest launched one. A fragment
// simdgroup has no thread for a fragment that was never launched, where the guest wave has
// a lane its reductions fill with the identity: an inclusive scan's value there is the one
// of the launched lane below it.
static inline uint sharpemu_present_lane(uint lane)
{
    uint present = sharpemu_ballot(true);
    uint below = present & (0xFFFFFFFFu >> (31u - (lane & 31u)));
    return below != 0u ? 31u - clz(below) : (present != 0u ? ctz(present) : (lane & 31u));
}

// The guest reciprocal, square-root, log and exp units read an F32 denormal input
// as a zero of the same sign, so rcp/rsq/sqrt/log/exp flush it before the MSL call
// rather than letting the denormal through to a finite result.
static inline float sharpemu_flush_f32_denorm(float value)
{
    uint bits = as_type<uint>(value);
    uint magnitude = bits & 0x7FFFFFFFu;
    return magnitude != 0u && magnitude < 0x00800000u ? as_type<float>(bits & 0x80000000u) : value;
}

// V_MIN/V_MAX/V_MIN3/V_MAX3/V_MED3 on f32 and f16 bits (RDNA2 ISA 12.7, 12.12): with
// MODE.IEEE a signalling NaN operand (src0 first) is returned quieted; otherwise a NaN
// operand yields the other one, and -0 orders below +0. Metal's fmin/fmax pick either
// zero and read f32 denormals as zero, so the order is taken on the bits.
static inline uint sharpemu_order_f32(uint bits)
{
    return (bits & 0x80000000u) != 0u ? ~bits : (bits | 0x80000000u);
}

static inline bool sharpemu_is_nan_f32(uint bits)
{
    return (bits & 0x7FFFFFFFu) > 0x7F800000u;
}

static inline uint sharpemu_min_f32(uint a, uint b, bool ieee)
{
    if (ieee && sharpemu_is_nan_f32(a) && (a & 0x00400000u) == 0u) return a | 0x00400000u;
    if (ieee && sharpemu_is_nan_f32(b) && (b & 0x00400000u) == 0u) return b | 0x00400000u;
    if (sharpemu_is_nan_f32(a)) return b;
    if (sharpemu_is_nan_f32(b)) return a;
    return sharpemu_order_f32(a) < sharpemu_order_f32(b) ? a : b;
}

static inline uint sharpemu_max_f32(uint a, uint b, bool ieee)
{
    if (ieee && sharpemu_is_nan_f32(a) && (a & 0x00400000u) == 0u) return a | 0x00400000u;
    if (ieee && sharpemu_is_nan_f32(b) && (b & 0x00400000u) == 0u) return b | 0x00400000u;
    if (sharpemu_is_nan_f32(a)) return b;
    if (sharpemu_is_nan_f32(b)) return a;
    return sharpemu_order_f32(a) > sharpemu_order_f32(b) ? a : b;
}

// V_MED3: MIN3 when any operand is NaN, else the max of the two operands other than the
// one MAX3 equals (a float equality, so +0 and -0 match).
static inline uint sharpemu_med3_f32(uint a, uint b, uint c, bool ieee)
{
    if (sharpemu_is_nan_f32(a) || sharpemu_is_nan_f32(b) || sharpemu_is_nan_f32(c))
        return sharpemu_min_f32(sharpemu_min_f32(a, b, ieee), c, ieee);
    uint top = sharpemu_max_f32(sharpemu_max_f32(a, b, ieee), c, ieee);
    if (top == a || ((top | a) & 0x7FFFFFFFu) == 0u) return sharpemu_max_f32(b, c, ieee);
    if (top == b || ((top | b) & 0x7FFFFFFFu) == 0u) return sharpemu_max_f32(a, c, ieee);
    return sharpemu_max_f32(a, b, ieee);
}

static inline uint sharpemu_order_f16(uint bits)
{
    return (bits & 0x8000u) != 0u ? (~bits & 0xFFFFu) : (bits | 0x8000u);
}

static inline bool sharpemu_is_nan_f16(uint bits)
{
    return (bits & 0x7FFFu) > 0x7C00u;
}

static inline uint sharpemu_min_f16(uint a, uint b, bool ieee)
{
    if (ieee && sharpemu_is_nan_f16(a) && (a & 0x0200u) == 0u) return a | 0x0200u;
    if (ieee && sharpemu_is_nan_f16(b) && (b & 0x0200u) == 0u) return b | 0x0200u;
    if (sharpemu_is_nan_f16(a)) return b;
    if (sharpemu_is_nan_f16(b)) return a;
    return sharpemu_order_f16(a) < sharpemu_order_f16(b) ? a : b;
}

static inline uint sharpemu_max_f16(uint a, uint b, bool ieee)
{
    if (ieee && sharpemu_is_nan_f16(a) && (a & 0x0200u) == 0u) return a | 0x0200u;
    if (ieee && sharpemu_is_nan_f16(b) && (b & 0x0200u) == 0u) return b | 0x0200u;
    if (sharpemu_is_nan_f16(a)) return b;
    if (sharpemu_is_nan_f16(b)) return a;
    return sharpemu_order_f16(a) > sharpemu_order_f16(b) ? a : b;
}

static inline uint sharpemu_med3_f16(uint a, uint b, uint c, bool ieee)
{
    if (sharpemu_is_nan_f16(a) || sharpemu_is_nan_f16(b) || sharpemu_is_nan_f16(c))
        return sharpemu_min_f16(sharpemu_min_f16(a, b, ieee), c, ieee);
    uint top = sharpemu_max_f16(sharpemu_max_f16(a, b, ieee), c, ieee);
    if (top == a || ((top | a) & 0x7FFFu) == 0u) return sharpemu_max_f16(b, c, ieee);
    if (top == b || ((top | b) & 0x7FFFu) == 0u) return sharpemu_max_f16(a, c, ieee);
    return sharpemu_max_f16(a, b, ieee);
}

// Guest sin/cos take revolutions and reduce them to one cycle as x - floor(x), the
// SPIR-V translator's Fract (MSL fract clamps just below 1.0, so it is not used).
// A finite magnitude of 2^23 or more has no fraction and reduces to exactly zero;
// infinity and NaN reduce to NaN. Sine passes a signed zero through so sin(-0) is -0.
static inline float sharpemu_trig_cycle_f32(float value, bool preserveSignedZero)
{
    uint magnitude = as_type<uint>(value) & 0x7FFFFFFFu;
    if (preserveSignedZero && magnitude < 0x00800000u)
    {
        // A zero, or a denormal flushed to a zero of its sign: sin(-0) is -0.
        return as_type<float>(as_type<uint>(value) & 0x80000000u);
    }

    if (magnitude >= 0x4B000000u && magnitude < 0x7F800000u)
    {
        return 0.0f;
    }

    return value - floor(value);
}

// A NaN a function made from a non-NaN operand is the ISA's 0xFFC00000 (RDNA2 ISA 12.8
// V_SQRT/RSQ/LOG/SIN/COS_F32 examples), not Metal's positive NaN; a NaN operand passes through.
static inline float sharpemu_invalid_nan_f32(float result, float operand)
{
    return (isnan(result) && !isnan(operand)) ? as_type<float>(0xFFC00000u) : result;
}

static constant float sharpemu_off_i4_table[16] =
{
    0.0f, 0.0625f, 0.1250f, 0.1875f, 0.2500f, 0.3125f, 0.3750f, 0.4375f,
    -0.5000f, -0.4375f, -0.3750f, -0.3125f, -0.2500f, -0.1875f, -0.1250f, -0.0625f,
};

// A dispatcher invocation that ran out of steps. The host binds one word per shader
// hash and reads it back when the submission completes, so a mistranslated loop-exit
// condition reports itself as [METAL-V2][STEP-CAP] instead of only looking slow.
static inline void sharpemu_note_step_cap(device atomic_uint* report)
{
    if (report != nullptr)
    {
        atomic_fetch_add_explicit(report, 1u, memory_order_relaxed);
    }
}
