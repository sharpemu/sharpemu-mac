// 64-bit (dword pair) atomicity. A guest qword atomic (BUFFER/GLOBAL_ATOMIC_*_X2) and a
// GLC BUFFER/GLOBAL_LOAD_DWORDX2 are each single-copy atomic on the hardware, so a
// reader never sees one half of a pair from before a write and the other half from
// after it. Metal has no 64-bit atomic load, store, exchange or compare-exchange (MSL 3.2
// and 4.0 offer only atomic_max/min_explicit on a device atomic_ulong, with no result),
// so the pair is run as two 32-bit atomics under a sequence lock.
//
// The lock is one 32-bit sequence word per slot of a table the host binds for every
// program (pair_locks): even while no writer is inside, odd while one is.
//   writer: CAS the word from even s to s + 1, fence, run each dword's 32-bit atomic,
//           fence, store s + 2.
//   reader: load s1, fence, load both dwords, fence, load s2; keep the pair only if
//           s1 is even and s1 == s2, otherwise read again.
// The fences are seq_cst device-scope fences, at least the acquire/release fences the
// fence-based seqlock needs (Boehm, "Can seqlocks get along with programming language
// memory models?", MSPC 2012), so a reader that keeps a pair saw no writer's stores in
// part: had it read any dword a writer stored, the fence pair would order that writer's
// s + 1 before its s2, and s1 == s2 even rules that out. Writers exclude each other
// through the CAS. Every dword access is itself a device atomic, so a 32-bit atomic that
// does not take the lock still reaches memory whole.
//
// A slot is chosen by bits 3..13 of the pair's GPU address. Guest memory windows are
// 16 KB aligned aliases of one host mapping, so the same guest qword seen through two
// overlapping windows still picks the same slot; distinct pairs that share a slot only
// serialize. A lane takes and releases the lock inside one branch of one loop trip
// (sharpemu_pair_try_lock), never across a reconvergence point, so lanes of one
// SIMD-group that contend for a slot cannot deadlock each other.
//
// A lock still odd after 2^20 tries can only be one a killed command buffer left behind;
// the access then goes ahead unlocked and counts as a step cap for the program, so it
// shows as [METAL-V2][STEP-CAP] rather than hanging the queue.
constant uint sharpemu_pair_lock_slots = 2048u;
constant uint sharpemu_pair_lock_tries = 1u << 20;

static inline device atomic_uint* sharpemu_pair_lock(device atomic_uint* locks, device uint* pair)
{
    return locks + ((uint)(reinterpret_cast<ulong>(pair) >> 3) & (sharpemu_pair_lock_slots - 1u));
}

// One try at the lock. True when the caller now runs its critical section: it owns the
// lock (seq holds the even value it took), or it gave up (seq is odd, see above).
static inline bool sharpemu_pair_try_lock(device atomic_uint* lock, thread uint& seq, thread uint& tries, device atomic_uint* report)
{
    uint observed = atomic_load_explicit(lock, memory_order_relaxed);
    if ((observed & 1u) == 0u &&
        atomic_compare_exchange_weak_explicit(lock, &observed, observed + 1u, memory_order_relaxed, memory_order_relaxed))
    {
        seq = observed;
        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
        return true;
    }
    if (++tries >= sharpemu_pair_lock_tries)
    {
        sharpemu_note_step_cap(report);
        seq = 1u;
        return true;
    }
    return false;
}

static inline void sharpemu_pair_unlock(device atomic_uint* lock, uint seq)
{
    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
    if ((seq & 1u) == 0u)
    {
        atomic_store_explicit(lock, seq + 2u, memory_order_relaxed);
    }
}

// Shared-LDS qword locks. Metal's threadgroup atomics are 32-bit, so a 64-bit LDS atomic
// that is not two independent 32-bit ones (a returning form, min/max, compare-store,
// exchange, inc/dec, the F64 forms) is a load, compute and store of both words, made
// atomic by a lock. The locks are slots of the same device table: a slot is picked by the
// qword's LDS index mixed with the threadgroup's position, so the same LDS index of
// different threadgroups (distinct memory) mostly picks different slots; a collision only
// serializes. Nothing needs initializing (the table is even when no one holds a slot),
// and no threadgroup memory is spent on it.
//   lock:   the pair lock's CAS from even s to s + 1 (sharpemu_pair_try_lock, with its
//           device fence), then a seq_cst fence over threadgroup and device memory;
//   unlock: the same fence, then s + 2.
// Every access to the qword inside the critical section is a 32-bit atomic load or store,
// and every LDS atomic of a program that locks runs inside the lock of the qword it
// touches, so the fences order each holder's accesses after the previous holder's (the
// CAS reads the previous unlock store) and no locked read-modify-write interleaves with
// another LDS atomic on the same qword. A lock is held across no reconvergence point, and
// one lane never holds two, so contending lanes of one SIMD-group cannot deadlock. The
// 2^20-try give-up of sharpemu_pair_try_lock applies (a step cap, never a hang).
static inline device atomic_uint* sharpemu_lds_pair_lock(device atomic_uint* locks, uint3 group, uint qword)
{
    uint key = qword + (group.x + group.y * 7919u + group.z * 104729u) * 613u;
    return locks + (key & (sharpemu_pair_lock_slots - 1u));
}

static inline bool sharpemu_lds_try_lock(device atomic_uint* lock, thread uint& seq, thread uint& tries, device atomic_uint* report)
{
    if (!sharpemu_pair_try_lock(lock, seq, tries, report))
    {
        return false;
    }
    atomic_thread_fence(mem_flags::mem_threadgroup | mem_flags::mem_device, memory_order_seq_cst, thread_scope_threadgroup);
    return true;
}

static inline void sharpemu_lds_unlock(device atomic_uint* lock, uint seq)
{
    atomic_thread_fence(mem_flags::mem_threadgroup | mem_flags::mem_device, memory_order_seq_cst, thread_scope_threadgroup);
    sharpemu_pair_unlock(lock, seq);
}

// Both dwords of a pair as one snapshot (a GLC LOAD_DWORDX2), read coherently. The
// dwords are normally adjacent; a swizzled V# can place them apart, and the lock is then
// still the one the first dword's address picks.
static inline uint2 sharpemu_pair_load(device atomic_uint* lock, device uint* first, device uint* second, device atomic_uint* report)
{
    for (uint tries = 0u; ; tries++)
    {
        uint before = atomic_load_explicit(lock, memory_order_relaxed);
        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
        uint2 value = uint2(
            atomic_load_explicit((device atomic_uint*)first, memory_order_relaxed),
            atomic_load_explicit((device atomic_uint*)second, memory_order_relaxed));
        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
        uint after = atomic_load_explicit(lock, memory_order_relaxed);
        if ((before & 1u) == 0u && before == after)
        {
            return value;
        }
        if (tries >= sharpemu_pair_lock_tries)
        {
            sharpemu_note_step_cap(report);
            return value;
        }
    }
}

// A GLC LOAD_DWORDX2 from a bound buffer: each dword at its own byte address, out of range
// reading zero as sharpemu_load_dword_coherent does. Only a pair wholly in range is one
// snapshot; a dword past the end has no value to tear.
static inline uint2 sharpemu_load_pair_coherent(device uint* b, uint bytes, uint first, uint second, device atomic_uint* locks, device atomic_uint* report)
{
    uint low = first >> 2;
    uint high = second >> 2;
    uint words = bytes >> 2;
    if (low < words && high < words)
    {
        return sharpemu_pair_load(sharpemu_pair_lock(locks, b + low), b + low, b + high, report);
    }
    return uint2(sharpemu_load_dword_coherent(b, bytes, first), sharpemu_load_dword_coherent(b, bytes, second));
}

// Three or four contiguous dwords of a record, read coherently as one snapshot under the
// first dword's lock: a persistent-thread kernel's GLC LOAD_DWORDX3/X4, whose record another
// workgroup writes with a store that takes the same lock (EmitPairLocked). A dword
// past the end reads zero, as sharpemu_load_dword_coherent does.
static inline uint4 sharpemu_load_record_coherent(device uint* b, uint bytes, uint first, uint count, device atomic_uint* locks, device atomic_uint* report)
{
    uint low = first >> 2;
    uint words = bytes >> 2;
    device atomic_uint* lock = sharpemu_pair_lock(locks, b + low);
    for (uint tries = 0u; ; tries++)
    {
        uint before = atomic_load_explicit(lock, memory_order_relaxed);
        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
        uint4 value = uint4(0u);
        for (uint word = 0u; word < count; word++)
        {
            value[word] = low + word < words ? atomic_load_explicit((device atomic_uint*)(b + low + word), memory_order_relaxed) : 0u;
        }
        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
        uint after = atomic_load_explicit(lock, memory_order_relaxed);
        if ((before & 1u) == 0u && before == after)
        {
            return value;
        }
        if (tries >= sharpemu_pair_lock_tries)
        {
            sharpemu_note_step_cap(report);
            return value;
        }
    }
}

// The device-address form: each dword is read only when the access keeps it in range
// (first_in_range / second_in_range) and the page table maps it, zero otherwise.
static inline uint2 sharpemu_load_device_pair_coherent(device const Gen5AddressRange* ranges, uint range_count, device uint* faults, uint fault_words, thread Gen5RangeCache& cache, ulong first, bool first_in_range, ulong second, bool second_in_range, device atomic_uint* locks, device atomic_uint* report)
{
    bool first_valid = false;
    bool second_valid = false;
    device uint* first_word = first_in_range ? sharpemu_resolve_device_address(ranges, range_count, faults, fault_words, cache, first, first_valid) : nullptr;
    device uint* second_word = second_in_range ? sharpemu_resolve_device_address(ranges, range_count, faults, fault_words, cache, second, second_valid) : nullptr;
    if (first_valid && second_valid)
    {
        return sharpemu_pair_load(sharpemu_pair_lock(locks, first_word), first_word, second_word, report);
    }
    return uint2(
        first_valid ? atomic_load_explicit((device atomic_uint*)first_word, memory_order_relaxed) : 0u,
        second_valid ? atomic_load_explicit((device atomic_uint*)second_word, memory_order_relaxed) : 0u);
}

// Global wave sync (DS_GWS_*, RDNA2 ISA 12.13). The 64 GWS resources live after the lock
// slots, four words each; word 0 is the resource's state. A semaphore counts in all of it;
// a barrier keeps its flag in bit 31 and the waves still to arrive in bits 30:0, so one
// compare-and-swap moves both. Word 1 counts SEMA_RELEASE_ALLs. Each call is made once
// per guest wave, by its first active lane, which the rest of the wave waits for.
//
// On hardware the GWS queues waves in the order they arrive and wakes them as counts
// allow. Here a wave spins on the word instead, and Metal gives no forward-progress
// guarantee between threadgroups: a wave waiting for one that is not yet resident would
// spin forever, so after 2^20 tries it gives up, counts a step cap and goes on (as the
// pair lock does). Within what is resident the counts behave as the ISA describes.
static inline device atomic_uint* sharpemu_gws_resource(device atomic_uint* locks, uint m0, uint offset0)
{
    return locks + sharpemu_pair_lock_slots + ((((m0 >> 16u) + offset0) & 63u) * 4u);
}

// DS_GWS_INIT: the state becomes DATA (a barrier's count, flag clear).
static inline uint sharpemu_gws_init(device atomic_uint* resource, uint value)
{
    atomic_store_explicit(resource, value & 0x7FFFFFFFu, memory_order_relaxed);
    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
    return 0u;
}

// DS_GWS_SEMA_V (count 1) and DS_GWS_SEMA_BR (count DATA): release that many waits.
static inline uint sharpemu_gws_sema_release(device atomic_uint* resource, uint count)
{
    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
    atomic_fetch_add_explicit(resource, count, memory_order_relaxed);
    return 0u;
}

// DS_GWS_SEMA_RELEASE_ALL: every wave waiting in SEMA_P now returns without taking a count.
static inline uint sharpemu_gws_sema_release_all(device atomic_uint* resource)
{
    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
    atomic_fetch_add_explicit(resource + 1, 1u, memory_order_relaxed);
    return 0u;
}

// DS_GWS_SEMA_P: wait until the count is positive and take one, or until a RELEASE_ALL
// that comes after the wait began.
static inline uint sharpemu_gws_sema_p(device atomic_uint* resource, device atomic_uint* report)
{
    uint releases = atomic_load_explicit(resource + 1, memory_order_relaxed);
    for (uint tries = 0u; ; tries++)
    {
        uint count = atomic_load_explicit(resource, memory_order_relaxed);
        if ((int)count > 0 &&
            atomic_compare_exchange_weak_explicit(resource, &count, count - 1u, memory_order_relaxed, memory_order_relaxed))
        {
            break;
        }
        if (atomic_load_explicit(resource + 1, memory_order_relaxed) != releases)
        {
            break;
        }
        if (tries >= sharpemu_pair_lock_tries)
        {
            sharpemu_note_step_cap(report);
            break;
        }
    }
    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
    return 0u;
}

// DS_GWS_BARRIER: a wave arriving at a count of zero is the last one; it flips the flag,
// which releases the waves that arrived before it, and stores DATA as the number still to
// arrive at the next barrier. Any other wave takes one from the count and waits for the
// flag to change.
static inline uint sharpemu_gws_barrier(device atomic_uint* resource, uint value, device atomic_uint* report)
{
    atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
    uint state = atomic_load_explicit(resource, memory_order_relaxed);
    for (;;)
    {
        uint flag = state & 0x80000000u;
        uint next = (state & 0x7FFFFFFFu) == 0u
            ? ((flag ^ 0x80000000u) | (value & 0x7FFFFFFFu))
            : state - 1u;
        if (atomic_compare_exchange_weak_explicit(resource, &state, next, memory_order_relaxed, memory_order_relaxed))
        {
            if ((state & 0x7FFFFFFFu) == 0u)
            {
                return 0u;
            }
            for (uint tries = 0u; (atomic_load_explicit(resource, memory_order_relaxed) & 0x80000000u) == flag; tries++)
            {
                if (tries >= sharpemu_pair_lock_tries)
                {
                    sharpemu_note_step_cap(report);
                    break;
                }
            }
            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
            return 0u;
        }
    }
}
