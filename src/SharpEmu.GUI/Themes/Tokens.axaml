<!--
Copyright (C) 2026 SharpEmu Emulator Project
SPDX-License-Identifier: GPL-2.0-or-later
Design tokens for the launcher: palette, type scale, radii and spacing.

The colours below are the Graphite theme, the default. LauncherThemes.cs
repaints these same brush instances when another theme is picked, so styles keep
using StaticResource and still follow the active theme. Elevation is expressed
by lightness: background < surface < raised < overlay. Hairline borders use one
alpha and only appear on surfaces and rows; filled buttons carry no border.
Shadows belong to floating layers (sheets, menus, toasts, dialogs) alone.
-->

<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="MaterialSymbolsRounded">avares://SharpEmu.GUI/Assets/Fonts/MaterialSymbolsRounded-400.ttf#Material Symbols Rounded</FontFamily>

  <!-- Neutrals -->
  <SolidColorBrush x:Key="BgBrush" Color="#121212" />
  <SolidColorBrush x:Key="ChromeBrush" Color="#0A0A0A" />
  <SolidColorBrush x:Key="CardBrush" Color="#222222" />
  <SolidColorBrush x:Key="ElevatedBrush" Color="#2A2A2A" />
  <SolidColorBrush x:Key="RaisedHoverBrush" Color="#353535" />
  <!-- Fills for controls that sit on a card or row (combo boxes, fields, row buttons). -->
  <SolidColorBrush x:Key="FieldBrush" Color="#323232" />
  <SolidColorBrush x:Key="FieldHoverBrush" Color="#3D3D3D" />
  <SolidColorBrush x:Key="GameOptionsMenuBrush" Color="#1A1A1A" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#262626" />
  <SolidColorBrush x:Key="ToastBrush" Color="#F0262626" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="TileHoverBrush" Color="#0BFFFFFF" />
  <SolidColorBrush x:Key="TileSelectedBrush" Color="#12FFFFFF" />

  <!-- Text: primary, secondary (>= 7:1 on every surface), muted (>= 4.5:1). -->
  <SolidColorBrush x:Key="TextBrush" Color="#F5F5F5" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCCCCC" />
  <SolidColorBrush x:Key="SettingsDescriptionBrush" Color="#ABABAB" />
  <SolidColorBrush x:Key="MutedBrush" Color="#9C9C9C" />
  <SolidColorBrush x:Key="FaintBrush" Color="#646464" />

  <!-- Accent: the primary action, switch-on, progress and selected fills.
       AccentForegroundBrush is the text and icon colour drawn on an accent fill. -->
  <Color x:Key="SystemAccentColor">#F2F2F2</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#F2F2F2" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#D4D4D4" />
  <SolidColorBrush x:Key="AccentTintBrush" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#111111" />

  <!-- Semantic colours tuned for dark surfaces. -->
  <SolidColorBrush x:Key="DangerBrush" Color="#FF7A86" />
  <SolidColorBrush x:Key="DangerHoverBrush" Color="#FF98A1" />
  <SolidColorBrush x:Key="DangerTintBrush" Color="#1FFF7A86" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#5DE3A4" />
  <SolidColorBrush x:Key="WarningBrush" Color="#F5C46E" />
  <SolidColorBrush x:Key="InfoBrush" Color="#6DAEFF" />

  <!-- Focus is the strongest thing on screen: a crisp white ring with a soft glow. -->
  <SolidColorBrush x:Key="FocusRingBrush" Color="#FFFFFF" />
  <BoxShadows x:Key="FocusRingShadow">0 0 0 2 #FFFFFFFF, 0 0 22 4 #4DFFFFFF</BoxShadows>
  <BoxShadows x:Key="SelectedRingShadow">0 0 0 2 #B3FFFFFF</BoxShadows>
  <BoxShadows x:Key="SheetShadow">0 8 32 0 #66000000</BoxShadows>
  <!-- Glass: controls that float over key art. A translucent white fill, a rim that
       is brightest along the top edge and an inner top highlight, so the art shows
       through and the control's edge reads as lit rather than cut out. -->
  <SolidColorBrush x:Key="GlassBrush" Color="#17FFFFFF" />
  <SolidColorBrush x:Key="GlassHoverBrush" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="GlassPressedBrush" Color="#33FFFFFF" />
  <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#47FFFFFF" />
    <GradientStop Offset="0.5" Color="#14FFFFFF" />
    <GradientStop Offset="1" Color="#0AFFFFFF" />
  </LinearGradientBrush>
  <BoxShadows x:Key="GlassShadow">inset 0 1 0 0 #1FFFFFFF, 0 6 18 0 #33000000</BoxShadows>
  <!-- Soft glow under the accent pill; the theme sets its colour. -->
  <BoxShadows x:Key="AccentGlowShadow">inset 0 1 0 0 #59FFFFFF, 0 8 28 -4 #80F2F2F2</BoxShadows>
  <!-- Underline under the active page title; the theme sets its colour. -->
  <BoxShadows x:Key="SegmentUnderlineShadow">0 6 0 -3 #F2F2F2</BoxShadows>

  <!-- Scrim that keeps text legible on any key art. -->
  <LinearGradientBrush x:Key="ArtScrimBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#D9121212" />
    <GradientStop Offset="0.4" Color="#CC121212" />
    <GradientStop Offset="1" Color="#F2121212" />
  </LinearGradientBrush>
  <!-- Fade that keeps trophy text legible over the blurred game art. -->
  <LinearGradientBrush x:Key="TrophyBackdropFadeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#801A1A1A" />
    <GradientStop Offset="0.45" Color="#E01A1A1A" />
    <GradientStop Offset="1" Color="#FA1A1A1A" />
  </LinearGradientBrush>
  <!-- Fade under the controller hint bar. -->
  <LinearGradientBrush x:Key="HintBarFadeBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#00121212" />
    <GradientStop Offset="1" Color="#F2121212" />
  </LinearGradientBrush>

  <!-- Radius scale: chips 6, buttons/inputs/rows 10, cards/tiles/panels 14. -->
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>
  <CornerRadius x:Key="RadiusLg">14</CornerRadius>

  <!-- Type scale (pt): caption 13, description 14, body 16, subtitle 20, title 28, display 40. -->
  <x:Double x:Key="FontSizeCaption">13</x:Double>
  <x:Double x:Key="FontSizeDescription">14</x:Double>
  <x:Double x:Key="FontSizeBody">16</x:Double>
  <x:Double x:Key="FontSizeSubtitle">20</x:Double>
  <x:Double x:Key="FontSizeTitle">28</x:Double>
  <x:Double x:Key="FontSizeDisplay">40</x:Double>

  <!-- Metrics: one page gutter, one control height. -->
  <x:Double x:Key="ControlHeight">44</x:Double>
  <x:Double x:Key="RowHeight">72</x:Double>

  <!-- The stock combo box tints itself with the system accent while focused; pin it to the field colours. -->
  <SolidColorBrush x:Key="ComboBoxBackground" Color="#323232" />
  <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#323232" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#3D3D3D" />
  <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#3D3D3D" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="Transparent" />
  <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="Transparent" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#F5F5F5" />
  <SolidColorBrush x:Key="ComboBoxForegroundFocusedPressed" Color="#F5F5F5" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocused" Color="#F5F5F5" />
  <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundFocusedPressed" Color="#F5F5F5" />
</ResourceDictionary>
