SPDX-License-Identifier: GPL-2.0-or-later
Shared sidebar navigation for global and per-game options: a coloured icon tile,
a label, and one filled highlight that slides to the current row.
-->

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.optionsNavSurface">
    <Setter Property="Width" Value="216" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.optionsNavIndicator">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.optionsNav">
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <Style Selector="Button.optionsNav /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
  </Style>

  <Style Selector="Button.optionsNav:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                   Button.optionsNav:pressed /template/ ContentPresenter#PART_ContentPresenter,
                   Button.optionsNav.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style Selector="Button.optionsNav:pressed">
    <Setter Property="RenderTransform" Value="none" />
  </Style>

  <!-- Icon tile: small rounded square, tinted per section like System Settings -->
  <Style Selector="Border.navIconTile">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="#8E8E93" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.navIconTile.blue"><Setter Property="Background" Value="#0A84FF" /></Style>
  <Style Selector="Border.navIconTile.teal"><Setter Property="Background" Value="#30B0C7" /></Style>
  <Style Selector="Border.navIconTile.green"><Setter Property="Background" Value="#30B650" /></Style>
  <Style Selector="Border.navIconTile.orange"><Setter Property="Background" Value="#FF9F0A" /></Style>
  <Style Selector="Border.navIconTile.purple"><Setter Property="Background" Value="#8E5CF0" /></Style>
  <Style Selector="Border.navIconTile.graphite"><Setter Property="Background" Value="#5C5C61" /></Style>

  <Style Selector="TextBlock.navIconGlyph">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.optionsNavLabel">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground"
                         Duration="0:0:0.15"
                         Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.optionsNav:pointerover TextBlock.optionsNavLabel,
                   Button.optionsNav.active TextBlock.optionsNavLabel">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
</Styles>
