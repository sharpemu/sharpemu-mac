Shared card, badge, hint and cover surfaces.
-->

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Metadata chip (title id, version, size): 13 pt on glass, 28 pt, fully round. -->
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{StaticResource GlassBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource GlassRimBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Session status/hotkey badges: the title-id pill geometry with a
       tinted fill so state (RUNNING) and keys (F11) read at a glance. -->
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.badge.running">
    <Setter Property="Background" Value="#1E46C46B" />
    <Setter Property="BorderBrush" Value="#5546C46B" />
  </Style>
  <Style Selector="Border.badge.key">
    <Setter Property="Background" Value="#1E58A6FF" />
    <Setter Property="BorderBrush" Value="#5558A6FF" />
  </Style>

  <!-- Gamepad shoulder-button keycap (L1/R1): shown only while a controller is connected. -->
  <Style Selector="Border.padHint">
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="BorderBrush" Value="#59FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="MinWidth" Value="36" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.padHint > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.coverShadow">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
  </Style>
  <Style Selector="Border.coverClip">
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
  </Style>
</Styles>
