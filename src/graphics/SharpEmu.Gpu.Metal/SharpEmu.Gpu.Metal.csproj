<!--
  The Metal graphics backend: Metal devices, resources, encoders, pipelines and
  the CAMetalLayer presenter, plus the MSL shader emitter it compiles through.

  It is the only GPU backend in a macOS build and it is never built for Windows
  or Linux; conversely it contains no Vulkan, MoltenVK or SDL reference, which
  is what lets a macOS publish output stay free of all three
  (see build/platforms/macos/macos.targets).
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SharpEmu.HLE\SharpEmu.HLE.csproj" />
    <ProjectReference Include="..\..\SharpEmu.Libs\SharpEmu.Libs.csproj" />
    <ProjectReference Include="..\..\SharpEmu.Logging\SharpEmu.Logging.csproj" />
    <ProjectReference Include="..\..\SharpEmu.ShaderCompiler\SharpEmu.ShaderCompiler.csproj" />
    <ProjectReference Include="..\..\SharpEmu.ShaderCompiler.Metal\SharpEmu.ShaderCompiler.Metal.csproj" />
    <!-- The shader warm-up progress panel drawn over the splash. -->
    <ProjectReference Include="..\SharpEmu.Gpu.ShaderProgress\SharpEmu.Gpu.ShaderProgress.csproj" />
    <!-- The AppKit window the presenter drives, and the GameController pad it
         attaches to the session. -->
    <ProjectReference Include="..\..\platforms\macos\SharpEmu.Platform.MacOS\SharpEmu.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.Libs.Tests" />
    <InternalsVisibleTo Include="SharpEmu.Gpu.Metal.Tests" />
    <InternalsVisibleTo Include="SharpEmu.Gpu.Metal.LeakTests" />
    <InternalsVisibleTo Include="SharpEmu.Tools.ShaderCompileBench" />
    <InternalsVisibleTo Include="SharpEmu.Tools.PerfAudit" />
  </ItemGroup>

</Project>
