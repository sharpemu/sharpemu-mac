<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\SharpEmu.LibAtrac9\SharpEmu.LibAtrac9.csproj" />
    <ProjectReference Include="..\SharpEmu.HLE\SharpEmu.HLE.csproj" />
    <ProjectReference Include="..\SharpEmu.Fonts.Abstractions\SharpEmu.Fonts.Abstractions.csproj" />
    <ProjectReference Include="..\SharpEmu.Logging\SharpEmu.Logging.csproj" />
    <ProjectReference Include="..\SharpEmu.ShaderCompiler\SharpEmu.ShaderCompiler.csproj" />
    <!-- The backend emitters moved out with their backends: the MSL emitter is
         referenced only by SharpEmu.Gpu.Metal and the SPIR-V emitter only by
         SharpEmu.Gpu.Vulkan. The shared engine keeps the guest-facing
         SharpEmu.ShaderCompiler above and nothing else. -->
    <!-- SysAbi export generator + analyzers (compile-time registry, NID validation). -->
    <ProjectReference Include="..\SharpEmu.SourceGenerators\SharpEmu.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PS5 symbol catalog: lets the analyzer flag export names it doesn't know. -->
    <AdditionalFiles Include="..\..\scripts\ps5_names.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpEmu.Libs.Tests" />
    <InternalsVisibleTo Include="SharpEmu.GnmMode" />
    <InternalsVisibleTo Include="SharpEmu.Gpu.Vulkan" />
    <!-- The runtime reads internal load-progress diagnostics. -->
    <InternalsVisibleTo Include="SharpEmu.Core" />
  </ItemGroup>

  <!-- Extracted backends and platform packages use explicit public contracts.
       The existing Core exception above is limited to loader diagnostics. -->

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="NLayer" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
