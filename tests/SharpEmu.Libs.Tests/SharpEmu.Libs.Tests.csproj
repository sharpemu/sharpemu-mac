<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tools/SharpEmu.Tools.PerfAudit/DarwinThreadCpuClock.cs" Link="Benchmarks/DarwinThreadCpuClock.cs" />
    <ProjectReference Include="../../src/adapters/SharpEmu.Fonts.Skia/SharpEmu.Fonts.Skia.csproj" />
    <ProjectReference Include="..\..\src\SharpEmu.Core\SharpEmu.Core.csproj" />
    <ProjectReference Include="..\..\src\SharpEmu.GnmMode\SharpEmu.GnmMode.csproj" />
    <ProjectReference Include="..\..\src\SharpEmu.Libs\SharpEmu.Libs.csproj" />
    <ProjectReference Include="..\..\src\SharpEmu.HLE\SharpEmu.HLE.csproj" />
    <ProjectReference Include="..\..\src\SharpEmu.GUI\SharpEmu.GUI.csproj" />
    <ProjectReference Include="..\..\src\SharpEmu.Debugger\SharpEmu.Debugger.csproj" />
    <!-- The resource-plan program builders drive the device tests of the new compile path. -->
    <ProjectReference Include="..\SharpEmu.ShaderCompiler.Tests\SharpEmu.ShaderCompiler.Tests.csproj" />
  </ItemGroup>

  <!-- Host OS package for the OS the tests run on, selected like SharpEmu.CLI
       does but keyed off the build host (these tests exercise the real host
       backend, so they are never cross-built). HostPlatformFixture.cs reads the
       matching SHARPEMU_HOST_* symbol. -->
  <PropertyGroup>
    <_SharpEmuHostOS Condition="$([MSBuild]::IsOSPlatform('OSX'))">macos</_SharpEmuHostOS>
    <_SharpEmuHostOS Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_SharpEmuHostOS>
    <_SharpEmuHostOS Condition="$([MSBuild]::IsOSPlatform('Windows'))">windows</_SharpEmuHostOS>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_SharpEmuHostOS)' == 'macos'">
    <DefineConstants>$(DefineConstants);SHARPEMU_HOST_MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SharpEmuHostOS)' == 'linux'">
    <DefineConstants>$(DefineConstants);SHARPEMU_HOST_LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SharpEmuHostOS)' == 'windows'">
    <DefineConstants>$(DefineConstants);SHARPEMU_HOST_WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(_SharpEmuHostOS)' == 'macos'">
    <ProjectReference Include="..\..\src\platforms\macos\SharpEmu.Host.MacOS\SharpEmu.Host.MacOS.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(_SharpEmuHostOS)' == 'linux'">
    <ProjectReference Include="..\..\src\platforms\linux\SharpEmu.Host.Linux\SharpEmu.Host.Linux.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(_SharpEmuHostOS)' == 'windows'">
    <ProjectReference Include="..\..\src\platforms\windows\SharpEmu.Host.Windows\SharpEmu.Host.Windows.csproj" />
  </ItemGroup>

  <!-- Direct-execution OS integration (W10). Unlike the graphics backends
       below, only the one this machine can run is referenced: the other two
       cannot load here (their native declarations and context layouts are
       this OS's siblings), and the whole point of the split is that a process
       carries exactly one. DirectExecutionPlatformFixture registers it. -->
  <PropertyGroup Condition="'$(_SharpEmuHostOS)' == 'macos'">
    <DefineConstants>$(DefineConstants);SHARPEMU_CPU_MACOS_X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SharpEmuHostOS)' == 'linux'">
    <DefineConstants>$(DefineConstants);SHARPEMU_CPU_LINUX_X64</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_SharpEmuHostOS)' == 'windows'">
    <DefineConstants>$(DefineConstants);SHARPEMU_CPU_WINDOWS_X64</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(_SharpEmuHostOS)' == 'macos'">
    <ProjectReference Include="..\..\src\platforms\macos\SharpEmu.Cpu.DirectExecution.MacOS.X64\SharpEmu.Cpu.DirectExecution.MacOS.X64.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(_SharpEmuHostOS)' == 'linux'">
    <ProjectReference Include="..\..\src\platforms\linux\SharpEmu.Cpu.DirectExecution.Linux.X64\SharpEmu.Cpu.DirectExecution.Linux.X64.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(_SharpEmuHostOS)' == 'windows'">
    <ProjectReference Include="..\..\src\platforms\windows\SharpEmu.Cpu.DirectExecution.Windows.X64\SharpEmu.Cpu.DirectExecution.Windows.X64.csproj" />
  </ItemGroup>

  <!-- The test assembly is not shipped, so unlike the application it references
       every backend and platform package and composes the one this machine can
       run (see FakeCpuMemory.ConfigureCommandStreamTests). That is also what
       lets the Metal and Vulkan backends be covered from one test run. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\graphics\SharpEmu.Gpu.Metal\SharpEmu.Gpu.Metal.csproj" />
    <ProjectReference Include="..\..\src\platforms\macos\SharpEmu.Platform.MacOS\SharpEmu.Platform.MacOS.csproj" />
    <ProjectReference Include="..\..\src\graphics\SharpEmu.Gpu.Vulkan\SharpEmu.Gpu.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\adapters\SharpEmu.Adapters.Sdl\SharpEmu.Adapters.Sdl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Fixtures/Tile5Volume/Tile5VolumeOracle.cs" Link="Fixtures/Tile5VolumeOracle.cs" />
    <EmbeddedResource Include="../Fixtures/Tile5Volume/offsets.csv" LogicalName="Tile5Volume.offsets.csv" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Fixtures/Bgra1024Array/Bgra1024Oracle.cs" Link="Fixtures/Bgra1024Oracle.cs" />
    <Compile Include="../Fixtures/R8FourKArray/R8FourKOracle.cs" Link="Fixtures/R8FourKOracle.cs" />
    <EmbeddedResource Include="../../docs/guest-ownership-trace.md" LogicalName="GuestOwnershipTraceGuide" />
  </ItemGroup>
</Project>
