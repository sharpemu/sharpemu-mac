<?xml version="1.0" encoding="UTF-8"?>
<!--
Copyright (C) 2026 SharpEmu Emulator Project
SPDX-License-Identifier: GPL-2.0-or-later

Info.plist template for SharpEmu.app. scripts/macos/build-app.sh substitutes
the @UPPERCASE@ placeholders; everything else is fixed policy.

Keys deliberately absent:

  LSRequiresNativeExecution — its *presence* makes the system prefer a native
  slice over a translated one, and Apple documents that an Intel-only binary
  linked against the macOS 11+ SDK will not run on Apple silicon at all when
  this key is set. Setting it to false is not a documented no-op, so the key is
  omitted rather than set either way. The x64 emulator must run translated.

  CFBundleIconName — that key names an asset-catalog entry (Assets.car).
  SharpEmu ships a loose .icns, which is CFBundleIconFile's job.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SharpEmu</string>
	<key>CFBundleName</key>
	<string>SharpEmu</string>
	<key>CFBundleIdentifier</key>
	<string>@SHARPEMU_BUNDLE_ID@</string>
	<key>CFBundleExecutable</key>
	<string>@SHARPEMU_EXECUTABLE@</string>
	<key>CFBundleIconFile</key>
	<string>@SHARPEMU_ICON_FILE@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHARPEMU_SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@SHARPEMU_BUNDLE_VERSION@</string>
	<key>NSHumanReadableCopyright</key>
	<string>SharpEmu Emulator Project — GPL-2.0-or-later</string>

	<!-- .NET 10 supports macOS 15 and later on both architectures, and the
	     Rosetta 2 x64 emulator is supported on Apple silicon within that
	     range. The native runtime itself is built against a 12.0 deployment
	     target, so a lower value here would only promise a configuration
	     nobody tests. -->
	<key>LSMinimumSystemVersion</key>
	<string>@SHARPEMU_MIN_MACOS@</string>

	<!-- Declare eligibility for macOS Game Mode. macOS controls activation
	     for native full-screen windows and preserves the user's setting.
	     The GC spelling serves older supported systems; LS is the current key.
	     These declarations do not force a scheduling policy or certify FPS. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.games</string>
	<key>LSSupportsGameMode</key>
	<true/>
	<key>GCSupportsGameMode</key>
	<true/>

	<!-- The architecture of the main executable: arm64 for the native GUI
	     host (the default), x86_64 when the x64 SharpEmu is the main executable.
	     The CPU backend executes guest x86-64 instructions natively, so the
	     emulator process the GUI starts is always x86-64 and runs under
	     Rosetta 2. Each executable is single-architecture, which makes this key
	     informational rather than load-bearing, but it keeps the choice explicit. -->
	<key>LSArchitecturePriority</key>
	<array>
		<string>@SHARPEMU_MAIN_ARCH@</string>
	</array>

	<!-- Without this the window is rendered at 1x and scaled up, which on a
	     Retina display looks like a blurry emulator rather than a blurry
	     window. -->
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Lets the window server keep the app on the integrated GPU when the
	     discrete one is not needed, instead of forcing a GPU switch for every
	     launch. Apple documents it for OpenGL; it is harmless for Metal and
	     still meaningful on Intel Macs with dual GPUs, which is exactly the
	     hardware an osx-x64 build runs on natively. -->
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- Game controller support. macOS routes DualSense/DualShock pads through
	     the Extended profile — GameController has no vendor-specific profile
	     names — so ExtendedGamepad is the complete list for a gamepad
	     emulator. GCSupportsControllerUserInteraction marks the app as
	     controller-aware so the system offers per-app button remapping. -->
	<key>GCSupportsControllerUserInteraction</key>
	<true/>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>

	<!-- Gen0 budget of the managed GC. The runtime sizes it from the L3 cache, which under
	     Rosetta 2 measured 10-20 MB, and the emulator allocates tens of MB a second on
	     its HLE and GPU threads: that is several gen0 collections a second, each stopping
	     every guest thread that is inside an import. 64 MB cuts the count about 8x on an
	     allocation microbenchmark. GCgen0size has no runtimeconfig.json form, only the
	     environment, so it is set here (LaunchServices launches) and in
	     scripts/macos/run-game.sh (direct launches). -->
	<key>LSEnvironment</key>
	<dict>
		<key>DOTNET_GCgen0size</key>
		<string>0x4000000</string>
	</dict>

	<!-- Opening a game by dragging an eboot.bin onto the icon is not wired up
	     yet (it needs the AppKit open-request handling in plan W26), so the
	     bundle claims no document types on purpose rather than claiming some
	     and ignoring the request. -->
</dict>
</plist>
